# Application URL
API_URL=https://app.myartelab.com

MONGODB_URI=mongodb://127.0.0.1:27017/myartelab
JWT_SECRET=your_jwt_secret_min_32_chars
WALLET_ENCRYPTION_KEY=your_wallet_encryption_key_min_32_chars
PLATFORM_WALLET_ADDRESS=your_solana_platform_wallet_address
PORT=5000

# Email Configuration
EMAIL_SERVICE=zoho
EMAIL_USER=contact@myartelab.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=MyArteLab <contact@myartelab.com>
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
NODE_ENV=development

# Switch API Configuration (Sandbox)
SWITCH_BASE_URL=https://api.onswitch.xyz
SWITCH_SERVICE_KEY=your_switch_sandbox_service_key_here
